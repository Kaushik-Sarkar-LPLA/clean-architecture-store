{
  "info": {
    "name": "Clean Architecture Store API (store.pixilens.online)",
    "description": "Postman Collection for .NET Clean Architecture E-Commerce Store with Identity, TodoLists, TodoItems, and Planned Store Extensions (SCRUM-6, SCRUM-7, SCRUM-8).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://store.pixilens.online",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth & Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priyankasoft@gmail.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Users",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priyankasoft@gmail.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Users",
                "login"
              ]
            }
          }
        },
        {
          "name": "User Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Users/manage/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Users",
                "manage",
                "info"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Todo Lists & Items (Baseline Endpoints)",
      "item": [
        {
          "name": "Get Todo Lists",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/TodoLists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "TodoLists"
              ]
            }
          }
        },
        {
          "name": "Create Todo List",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Practice Tasks\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/TodoLists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "TodoLists"
              ]
            }
          }
        },
        {
          "name": "Create Todo Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listId\": 1,\n  \"title\": \"Complete SCRUM-6 User Story\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/TodoItems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "TodoItems"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "SCRUM-6: Inventory Tracking (To Implement)",
      "item": [
        {
          "name": "Deduct Stock - Success (200 OK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantityToDeduct\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Products/1/deduct-stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Products",
                "1",
                "deduct-stock"
              ]
            }
          }
        },
        {
          "name": "Deduct Stock - Out of Stock (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantityToDeduct\": 9999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Products/1/deduct-stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Products",
                "1",
                "deduct-stock"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "SCRUM-7: Coupon Validation (To Implement)",
      "item": [
        {
          "name": "Validate Coupon - Valid 20% Off",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE20\",\n  \"orderSubtotal\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Coupons/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [

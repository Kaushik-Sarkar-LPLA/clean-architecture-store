              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"EXPIRED50\",\n  \"orderSubtotal\": 50.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Coupons/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Coupons",
                "validate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "SCRUM-8: Product Reviews (To Implement)",
      "item": [
        {
          "name": "Submit Product Review - 5 Stars",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"rating\": 5,\n  \"reviewerName\": \"Priyanka Sarkar\",\n  \"title\": \"High Quality\",\n  \"comment\": \"Excellent quality, responsive customer service and quick shipping!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/Products/1/reviews",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Products",
                "1",
                "reviews"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Documentation & Weather",
      "item": [
        {
          "name": "OpenAPI v1 Specification",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/openapi/v1.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi",
                "v1.json"
              ]
            }
          }
        },
        {
          "name": "Weather Forecasts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/WeatherForecasts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "WeatherForecasts"
              ]
            }
          }
        }
      ]
    }
  ]
}